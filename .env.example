# Copy to .env and fill in. Never commit .env.

# Your domain (DNS A/AAAA record pointing at this server). Enables HTTPS cookies/CSRF for it.
# Leave empty when using Tailscale or a proxy you configure yourself (then set CSRF_TRUSTED_ORIGINS).
DOMAIN=damdi.example.com

# First login — created on first start. Change the password!
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-please
DJANGO_SUPERUSER_EMAIL=you@example.com

TZ=Asia/Kolkata

# Contact for Web Push (Apple/Google require a real mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com

# Without DOMAIN, e.g. behind Tailscale serve:
# CSRF_TRUSTED_ORIGINS=https://myserver.tailnet-name.ts.net
# ALLOWED_HOSTS=myserver.tailnet-name.ts.net,localhost

# Where the app port listens on the host (default 127.0.0.1 = only this machine / your proxy).
# BIND=0.0.0.0

# Optional LLM for smarter Ramble parsing (Ollama, OpenAI-compatible):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
