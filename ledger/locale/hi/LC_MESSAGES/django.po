msgstr "सैलरी, स्टाइपेंड, सब्सक्रिप्शन: रिमाइंडर + एक टैप"

#: views.py:225
msgid "Bring in history from a spreadsheet"
msgstr "स्प्रेडशीट से पुराना हिसाब लाएँ"

#: views.py:226
msgid "Admin"
msgstr "एडमिन"

#: views.py:226
msgid "Categories, tags, SMS templates, everything"
msgstr "श्रेणियाँ, टैग, SMS टेम्पलेट, सब कुछ"

#: views.py:250
msgid "Paisapeek says hi 👋"
msgstr "पैसापीक की ओर से नमस्ते 👋"

#: views.py:250
msgid "Notifications work. We'll nudge you, not nag you."
msgstr "नोटिफ़िकेशन चल रहे हैं। हम याद दिलाएँगे, परेशान नहीं करेंगे।"

#: views.py:284
msgid "Choose a backup file."
msgstr "बैकअप फ़ाइल चुनें।"

#: views.py:286
msgid "Tick “replace my current data” to restore over existing data."
msgstr ""
"मौजूदा डेटा पर वापस लाने के लिए “मेरा मौजूदा डेटा बदल दें” पर टिक करें।"

#: views.py:293
#, python-format
msgid "Restored: %(items)s."
msgstr "वापस आ गया: %(items)s।"

#: views.py:315
msgid "This account has transactions, so it can't be deleted."
msgstr "इस खाते में लेन-देन हैं, इसलिए इसे हटाया नहीं जा सकता।"

#: views.py:322
msgid "Account saved."
msgstr "खाता सेव हो गया।"

#: views.py:371
#, python-format
msgid "Logged %(name)s as received; next on %(date)s."
msgstr "%(name)s मिल गया लिख लिया; अगली बार %(date)s को।"

#: views.py:372
#, python-format
msgid "Logged %(name)s as paid; next on %(date)s."
msgstr "%(name)s चुका दिया लिख लिया; अगली बार %(date)s को।"

#: views.py:422
msgid "Tick at least one row to add."
msgstr "जोड़ने के लिए कम से कम एक पंक्ति चुनें।"

#: views.py:426
#, python-format
msgid "Added %(n)d transaction — nicely done 🪙"
msgid_plural "Added %(n)d transactions — nicely done 🪙"
msgstr[0] "%(n)d लेन-देन जुड़ गया — शाबाश 🪙"
msgstr[1] "%(n)d लेन-देन जुड़ गए — शाबाश 🪙"

#: views.py:434
msgid "Fix the highlighted rows."
msgstr "निशान वाली पंक्तियाँ ठीक करें।"

#: views.py:465
msgid "Choose a CSV file."
msgstr "CSV फ़ाइल चुनें।"

#: views.py:467
msgid "File is over 2 MB; split it up."
msgstr "फ़ाइल 2 MB से बड़ी है; इसे तोड़ लीजिए।"

#: views.py:527
msgid "Has transactions; reassign or delete those first."
msgstr "इसमें लेन-देन हैं; पहले उन्हें बदलें या हटाएँ।"
